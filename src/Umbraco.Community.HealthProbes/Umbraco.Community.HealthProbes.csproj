<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
<TargetFramework>net10.0</TargetFramework>
<ImplicitUsings>enable</ImplicitUsings>
<Nullable>enable</Nullable>
</PropertyGroup>

<PropertyGroup>
<Version>1.0.0-beta3</Version>
<PackageId>Umbraco.Community.HealthProbes</PackageId>
<Product>Umbraco.Community.HealthProbes</Product>
<Title>Umbraco.Community.HealthProbes</Title>
<Description>Health probe package infrastructure for Umbraco CMS.</Description>
<Authors>Erik-Jan Westendorp</Authors>
<PackageTags>umbraco-marketplace umbraco plugin package health probes</PackageTags>
<PackageProjectUrl>https://github.com/erikjanwestendorp/Umbraco.Community.HealthProbes</PackageProjectUrl>
<RepositoryUrl>https://github.com/erikjanwestendorp/Umbraco.Community.HealthProbes</RepositoryUrl>
<RepositoryType>git</RepositoryType>
<PackageReadmeFile>README.md</PackageReadmeFile>
<PackageLicenseFile>LICENSE</PackageLicenseFile>
</PropertyGroup>

<ItemGroup>
<None Include="README.md" Pack="true" PackagePath="\" />
<None Include="..\\..\\LICENSE" Pack="true" PackagePath="\" />
</ItemGroup>

<ItemGroup>
<PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0, 18.0.0)" />
</ItemGroup>

<ItemGroup>
<FrameworkReference Include="Microsoft.AspNetCore.App" />
</ItemGroup>

</Project>
